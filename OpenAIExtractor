from typing import Optional, Dict
import warnings
from BaseExtractor import BaseExtractor
from transformers import BitsAndBytesConfig

class OpenAIExtractor(BaseExtractor):
    MODELS = {
        "gpt-4o",
        "gpt-4o-mini"
    }
    
    def __init__(self, model: str, quant: Optional[str|Dict] = None):
        if model not in self.MODELS:
            raise ValueError(f"Model {model} not supported for OpenAIExtractor. Supported models are {self.MODELS}")
        super().__init__(model, quant)
    
    def _determine_model_source(self) -> str:
        return "openai"
        
    def _set_quant(self, quant: Optional[str|Dict|BitsAndBytesConfig] = None) -> Optional[BitsAndBytesConfig]:
        warnings.warn("Quantization is not supported for non-Hugging Face models.")
        return None